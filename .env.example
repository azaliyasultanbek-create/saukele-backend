# Database
DATABASE_URL=postgresql://postgres:Azaliya2007@localhost:5432/saukele
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis
REDIS_URL="redis://localhost:6379"

# JWT Secrets (min 32 characters)
JWT_SECRET="your_super_secret_jwt_key_min_32_chars"
JWT_REFRESH_SECRET="your_super_secret_refresh_key_min_32_chars"

# Email Service

EMAIL_FROM_NAME="Saukele"
FRONTEND_URL="http://localhost:3000"
# true = no Redis worker required; with a real SG.* key, emails are sent directly from the API process
USE_MOCK_REDIS=true

# Kaspi Pay (for later)
KASPI_API_KEY="ksp_test_placeholder"
KASPI_WEBHOOK_SECRET="whsec_placeholder"

# Admin
ADMIN_API_KEY="admin_secure_key_placeholder"

# Environment
NODE_ENV="development"
PORT="3000"
